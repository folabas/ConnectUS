# ---------------------------------------------------------------------------
# Required. The server validates these at boot and exits if any are invalid.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/connectus

# Must be at least 32 characters and must not look like a placeholder.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Comma-separated origins allowed to call the API and open sockets.
# Add your production domains here rather than editing server.ts.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional. Missing values disable the feature rather than crashing a request.
# ---------------------------------------------------------------------------

# Email — needed for password reset and room invitations.
# Either SMTP:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@connectus.com
# ...or Resend:
RESEND_API_KEY=

# Mux — needed only for user uploads. The public-domain catalog works without it.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# WebRTC ICE servers.
#
# STUN has a working default and needs no account. TURN is optional but
# strongly recommended for launch: STUN alone cannot connect peers behind
# symmetric NAT, which is roughly 10-20% of users. Those people can watch and
# chat, but their camera and microphone never reach anyone.
#
# Comma-separated. Include both turn: and turns: if your provider offers TLS.
STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_URLS=

# Preferred: a shared secret, from which the API issues credentials that expire
# after 12 hours (the coturn "REST API" / Twilio scheme). Nothing long-lived is
# ever handed to a browser.
TURN_SECRET=

# Fallback: static credentials, used only when TURN_SECRET is empty. Simpler to
# set up; valid for as long as you leave them here.
TURN_USERNAME=
TURN_PASSWORD=

# Set to 'true' to exercise rate limiting outside production.
FORCE_RATE_LIMIT=
